[Desktop Entry]
Type=Application
Name=Monitors
Comment=Save the current display layout as an autorandr profile
Icon=preferences-desktop-display
Exec=sh -c 'n=$(rofi -dmenu -p "profile name" -l 0) && [ -n "$n" ] && autorandr --save "$n" --force && notify-send "Displays" "Profile \"$n\" saved"'
Terminal=false
Categories=Settings;HardwareSettings;
