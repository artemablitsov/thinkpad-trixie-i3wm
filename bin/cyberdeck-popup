#!/usr/bin/env bash
# cyberdeck-popup <имя> <команда…> — TUI в плавающем окне kitty по центру
# основного монитора (правила for_window в ~/.config/i3/config). Esc — закрыть.
# Повторный вызов с тем же именем: если окно сейчас активно — закрывает его
# (переключатель), если открыто, но не в фокусе — возвращает в центр основного
# монитора поверх всего и делает активным.
name="${1:?name}"; shift
[[ $# -gt 0 ]] || set -- "$name"
title="cdpop:$name"
# Окно узнаём по instance из WM_CLASS (--name): заголовок программа в терминале
# может поменять сама (htop, nmtui), а instance — нет
inst="cdpop-${name//[^A-Za-z0-9_-]/_}"
if pid=$(pgrep -u "$(id -u)" -f -- "--title $title( |$)"); then
  if xprop -id "$(xdotool getactivewindow 2>/dev/null)" WM_CLASS 2>/dev/null | grep -q "\"$inst\""; then
    kill $pid 2>/dev/null
  else
    sel="[instance=\"^${inst}\$\"]"
    # Основного монитора может не быть (xrandr без --primary) — тогда текущий
    i3-msg -q "$sel move container to output primary, move position center, focus" 2>/dev/null \
      || i3-msg -q "$sel move container to workspace current, move position center, focus" \
      || kill $pid 2>/dev/null
  fi
  exit 0
fi
# Esc закрывает окно — но только там, где программа сама Esc не использует,
# иначе он отнимал бы у неё «назад» и «отмену»:
#   s-tui                — Esc не нужен ей → kitty закрывает окно по Esc;
#   pulsemixer, nmtui    — выходят по Esc сами (nmtui — с главного экрана;
#                          в формах Esc — «назад»);
#   htop, ikhal, bluetuith, jolt — Esc у них занят (отмена поиска и фильтра,
#                          закрытие диалогов и меню) — не трогаем, выход — q.
esc=()
case "${1##*/}" in s-tui) esc=(-o "map=esc close_window") ;; esac
exec kitty --class cyberdeck-popup --name "$inst" --title "$title" \
  -o remember_window_size=no -o confirm_os_window_close=0 "${esc[@]}" \
  -e "$@"
