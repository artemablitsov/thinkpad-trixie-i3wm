#!/usr/bin/env bash
# cyberdeck-git-signing [ключ.pub] — подписывать коммиты и теги ключом SSH.
# Пишет ~/.config/git/local и ~/.config/git/allowed_signers (для `git log --show-signature`).
# Ключа нет — создайте: ssh-keygen -t ed25519 -C "$(git config user.email)"
# На GitHub ключ добавляется ещё раз, как Signing key: gh ssh-key add КЛЮЧ.pub --type signing
set -eu
key=${1:-}
if [[ -z "$key" ]]; then
  for k in ~/.ssh/id_ed25519.pub ~/.ssh/id_ecdsa.pub ~/.ssh/id_rsa.pub; do
    [[ -r $k ]] && { key=$k; break; }
  done
fi
[[ -n "$key" && -r "$key" ]] || {
  echo "No public SSH key. Create one: ssh-keygen -t ed25519 -C \"$(git config user.email)\"" >&2; exit 1; }
email=$(git config user.email)
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/git"
mkdir -p "$cfg"
printf '%s namespaces="git" %s\n' "$email" "$(cut -d' ' -f1,2 "$key")" > "$cfg/allowed_signers"
cat > "$cfg/local" <<EOT
# Generated by cyberdeck-git-signing — sign commits and tags with an SSH key
[user]
	signingKey = $key
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = $cfg/allowed_signers
[commit]
	gpgSign = true
[tag]
	gpgSign = true
EOT
echo "Signing enabled: $key"
echo "Add it on GitHub as a signing key:  gh ssh-key add $key --type signing"
