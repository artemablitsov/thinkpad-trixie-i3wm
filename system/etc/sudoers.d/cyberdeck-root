# Cyberdeck: sudo передаёт COLORTERM — по нему mc и Neovim от имени root узнают,
# что терминал умеет 24-битный цвет, и включают бордовые темы nord-root (без него
# mc откатился бы на запасной 16-цветный скин). Безобидная переменная: только
# сообщает, сколько цветов у терминала.
Defaults env_keep += "COLORTERM"
