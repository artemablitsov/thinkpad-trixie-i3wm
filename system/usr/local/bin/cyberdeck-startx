#!/bin/sh
# cyberdeck-startx — startx без вывода на экран.
# Всё, что X-сервер, xinit и i3 пишут в консоль («X.Org X Server…», «xauth: …»),
# уходит в журнал ~/.local/state/cyberdeck/startx.log, а не на чёрный экран
# между входом и рабочим столом.
log="${XDG_STATE_HOME:-$HOME/.local/state}/cyberdeck/startx.log"
mkdir -p "${log%/*}"
[ -f "$log" ] && mv -f "$log" "$log.old"
# Чистый чёрный экран без курсора, пока X не переключит видеорежим
if [ -t 0 ]; then printf '\033[2J\033[H\033[?25l' > /dev/tty 2>/dev/null; fi
startx "$@" >"$log" 2>&1
rc=$?
if [ -t 0 ]; then printf '\033[?25h\033[2J\033[H' > /dev/tty 2>/dev/null; fi
exit $rc
